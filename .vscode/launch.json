{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug server",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/server.exe",
      "args": [
        "8080",
        "${workspaceFolder}/data/runtime"
      ],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "externalConsole": false,
      "preLaunchTask": "CMake: build",
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Debug store",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/store.exe",
      "args": [],
      "cwd": "${workspaceFolder}/data/runtime",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "externalConsole": false,
      "preLaunchTask": "CMake: build",
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
